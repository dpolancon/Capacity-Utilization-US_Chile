# ── Secrets and Environment ──────────────────────────
.env
*.env
.env.*

# ── Python & Virtual Environments ────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
ENV/
env/

# ── IDE & Local Tooling ──────────────────────────────
.claudeprism/
.prism/
.claude/
.DS_Store
* - copia/
* - copia
* - copy/
* - copy

# ── Scratch & Ephemeral Work ─────────────────────────
scratch/

# ── R artifacts ──────────────────────────────────────
.Rhistory
**/.Rhistory
.RData
.Rproj.user/
.Ruserdata
Rplots.pdf

# ── Docs bundles ─────────────────────────────────────
docs/**/*.zip
docs/**/*.docx
docs/essay_tex/*.tex
docs/essay_tex/*.pdf

# ── Obsidian local cache ─────────────────────────────
chapter2_vault/.obsidian/workspace.json
chapter2_vault/.obsidian/graph.json

# ── Local figures — do not track ─────────────────────
*.pdf
*.png

# ── Versioned research artifacts ─────────────────────
# Whitelist explicit research artifacts across machines
!docs/**/*.pdf
!chapter2_paper/**/*.pdf
!chapter2_vault/**/*.pdf
!chapter2_vault/**/*.png
!output/**
!reports/**

# ── Post-Whitelist Overrides (MUST come after !output/** and !reports/**) ──
# 1. Reproducible binary outputs (large/reproducible)
output/**/*.rds
output/*.rds
output/**/*.RData
output/*.RData
output/Manifest/

# 2. Global LaTeX build junk
*.aux
*.nav
*.snm
*.vrb
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.synctex.gz
